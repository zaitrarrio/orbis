{
  "name": "orbis-cuda128",
  "imageName": "YOUR_REGISTRY/orbis:cuda128",
  "category": "NVIDIA",
  "containerDiskInGb": 50,
  "volumeInGb": 50,
  "volumeMountPath": "/workspace",
  "ports": ["22/tcp"],
  "dockerStartCmd": ["bash"],
  "env": {
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility",
    "PYTHONUNBUFFERED": "1"
  },
  "readme": "Orbis Live Model — Linux CUDA 12.8. Prefer RTX 4090, RTX 5090, or H100. Driver ≥ 570."
}
